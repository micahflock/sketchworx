+// ConstraintEqualCurvature
+ConstraintEqualCurvature::ConstraintEqualCurvature(Point& ja,
+                                                   Point& a1,
+                                                   Point& a2,
+                                                   int na_,
+                                                   Point& jb,
+                                                   Point& b1,
+                                                   Point& b2,
+                                                   int nb_)
+    : na(na_)
+    , nb(nb_)
+    , sb(0.)
+{
+    for (Point* p : {&ja, &a1, &a2, &jb, &b1, &b2}) {
+        pvec.push_back(p->x);
+        pvec.push_back(p->y);
+    }
+    origpvec = pvec;
+    double la = std::hypot(*a1.x - *ja.x, *a1.y - *ja.y);
+    double lb = std::hypot(*b1.x - *jb.x, *b1.y - *jb.y);
+    lref = std::max(1e-9, 0.5 * (la + lb));
+    rescale();
+}
+
+ConstraintEqualCurvature::ConstraintEqualCurvature(Point& ja, Point& a1, Point& a2, int na_, Arc& b, int arcSign)
+    : na(na_)
+    , nb(0)
+    , sb(arcSign >= 0 ? 1. : -1.)
+{
+    for (Point* p : {&ja, &a1, &a2}) {
+        pvec.push_back(p->x);
+        pvec.push_back(p->y);
+    }
+    pvec.push_back(b.rad);
+    origpvec = pvec;
+    lref = std::max(1e-9, std::fabs(*b.rad));
+    rescale();
+}
+
+ConstraintType ConstraintEqualCurvature::getTypeId()
+{
+    return EqualCurvature;
+}
+
+void ConstraintEqualCurvature::rescale(double coef)
+{
+    scale = coef * lref;
+}
+
+// Signed curvature of a Bezier end, leaving the joint. i is the pvec offset of the joint.
+double ConstraintEqualCurvature::kappaBezier(int i, int n)
+{
+    double jx = *pvec[i], jy = *pvec[i + 1];
+    double ux = *pvec[i + 2] - jx, uy = *pvec[i + 3] - jy;
+    double vx = *pvec[i + 4] - *pvec[i + 2], vy = *pvec[i + 5] - *pvec[i + 3];
+    double l = std::hypot(ux, uy);
+    if (l < 1e-12 || n < 2) {
+        return 0.;
+    }
+    return (double(n - 1) / double(n)) * (ux * vy - uy * vx) / (l * l * l);
+}
+
+double ConstraintEqualCurvature::error()
+{
+    double ka = kappaBezier(0, na);
+    double kb = nb > 0 ? kappaBezier(6, nb) : sb / *pvec[6];
+    return scale * (ka + kb);
+}
+
+double ConstraintEqualCurvature::grad(double* param)
+{
+    bool found = false;
+    for (double* p : pvec) {
+        if (p == param) {
+            found = true;
+            break;
+        }
+    }
+    if (!found) {
+        return 0.;
+    }
+    // Central differences: the expression is smooth away from degenerate (zero-length) handles.
+    double v = *param;
+    double h = 1e-7 * std::max(1., std::fabs(v));
+    *param = v + h;
+    double ep = error();
+    *param = v - h;
+    double em = error();
+    *param = v;
+    return (ep - em) / (2. * h);
+}
