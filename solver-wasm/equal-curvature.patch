+// EqualCurvature (G2 continuity, added for Sketchworx)
+// Equal signed curvature where two curves meet. Each side is described "away from the joint":
+// a Bezier end (joint J, next control point Q1, the one after Q2, degree n) or a circular arc
+// (center, radius, and +1/-1 for CCW/CW travel away from the joint).
+// kappa_away(Bezier) = (n-1)/n * cross(Q1-J, Q2-Q1) / |Q1-J|^3, kappa_away(arc) = sign / r.
+// Two curves passing through the joint have equal curvature when kappa_a + kappa_b = 0.
+class ConstraintEqualCurvature: public Constraint
+{
+private:
+    int na;      // degree of side a (always a Bezier)
+    int nb;      // degree of side b, 0 when side b is an arc
+    double sb;   // arc side: +1 if travel away from the joint is CCW
+    double lref; // length scale so the error is dimensionless
+    double kappaBezier(int i, int n);
+
+public:
+    ConstraintEqualCurvature(Point& ja, Point& a1, Point& a2, int na, Point& jb, Point& b1, Point& b2, int nb);
+    ConstraintEqualCurvature(Point& ja, Point& a1, Point& a2, int na, Arc& b, int arcSign);
+#ifdef _GCS_EXTRACT_SOLVER_SUBSYSTEM_
+    inline ConstraintEqualCurvature()
+    {}
+#endif
+    ConstraintType getTypeId() override;
+    void rescale(double coef = 1.) override;
+    double error() override;
+    double grad(double*) override;
+};
